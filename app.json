{
  "expo": {
    "name": "Pulse Gym",
    "slug": "pulse-gym",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.pulsegym.local",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Koppel direk met jou vriende vir ge\u00ebnkripteerde challenges en gedeelde workouts."
      }
    },
    "android": {
      "package": "app.pulsegym.local",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-font"
    ],
    "scheme": "pulsegym"
  }
}
